{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and credits balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "user", "guest"] },
        "credits": { "type": "number" },
        "plan": { "type": "string", "enum": ["free", "starter", "pro", "agency"] },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "credits", "plan", "createdAt"]
    },
    "BrandProfile": {
      "title": "BrandProfile",
      "description": "Brand Brain personalized profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "targetAudience": { "type": "string", "maxLength": 1000 },
        "painPoints": { "type": "string", "maxLength": 1000 },
        "tone": { "type": "string", "maxLength": 200 },
        "preferredLanguage": { "type": "string", "enum": ["English", "Tamil", "Tanglish"] },
        "preferredCta": { "type": "string", "maxLength": 300 },
        "wordsToAvoid": { "type": "string", "maxLength": 500 },
        "website": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "description", "createdAt", "updatedAt"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "Saved content item generated by Flowora AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "contentType": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "language": { "type": "string" },
        "version": { "type": "number" },
        "isFavorite": { "type": "boolean" },
        "isDraft": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "contentType", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and credit balances"
    },
    "/users/{userId}/brands/{brandId}": {
      "schema": { "$ref": "#/entities/BrandProfile" },
      "description": "Stores user personalized Brand Brain guidelines"
    },
    "/users/{userId}/content/{contentId}": {
      "schema": { "$ref": "#/entities/ContentItem" },
      "description": "Stores user generated scripts, reels, and articles"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Privileged administrator documents"
    }
  }
}
